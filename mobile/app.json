{
  "expo": {
    "name": "Sibling Rewards",
    "slug": "sibling-rewards",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "siblingrewards",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "household-updates",
          "color": "#F7A261"
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.configure-when-ios-is-added"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sibling Rewards uses your photos as proof of completed activities.",
          "cameraPermission": "Sibling Rewards uses your camera to photograph completed activities.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.chiboyfeni.siblingrewards"
    }
  }
}
