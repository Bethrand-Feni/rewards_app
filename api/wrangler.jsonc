{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sibling-rewards-api-dev",
  "main": "app/main.py",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sibling-rewards-dev",
      "database_id": "1315dd35-54dc-4778-9272-40501d12ea6d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sibling-rewards-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOUSEHOLD_REALTIME",
        "class_name": "HouseholdRealtime"
      }
    ]
  },
  "exports": {
    "HouseholdRealtime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGIN": "*",
    "DELETION_PURGE_ENABLED": "false",
    "GOOGLE_ANDROID_CLIENT_ID": "536752181631-4f75k5iabj95s3sv6h0p6gqg1tk2pm9a.apps.googleusercontent.com",
    "GOOGLE_WEB_CLIENT_ID": "536752181631-qrmo9j5jg94fpldjc767ptv4u0t8rt4u.apps.googleusercontent.com"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
